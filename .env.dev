# Muestra para desarrollo (regtest con Polar). Copiar a .env: cp .env.dev .env
# Sirve para correr uvicorn en el host y para docker compose (que pisa adentro del
# contenedor el host de LND, las rutas montadas y la DB).

COMPOSE_PROJECT_NAME=ln2oc

# LND Connection Settings (Polar, en el host)
LND_GRPC_HOST=127.0.0.1:10001
# Rutas del HOST. docker compose monta estos dos archivos en el contenedor.
LND_MACAROON_PATH=/home/lucas/.polar/networks/3/volumes/lnd/Kross/data/chain/bitcoin/regtest/admin.macaroon
LND_TLS_CERT_PATH=/home/lucas/.polar/networks/3/volumes/lnd/Kross/tls.cert
# Desde el contenedor, Polar se ve en el host:
DOCKER_LND_GRPC_HOST=host.docker.internal:10001
# host.docker.internal no está en los SANs del cert de Polar:
DOCKER_LND_TLS_SERVER_NAME=localhost

# Bitcoin & Swap Settings
BITCOIN_NETWORK=regtest
SWAP_FEE_RATE=0.007
MIN_PAYOUT_SAT=546
MIN_SWAP_SAT=1000
MAX_SWAP_SAT=1000000
MIN_SAT_PER_VBYTE=1
ONCHAIN_RESERVE_SAT=10000

# Payment detection (synchronous polling of PENDING invoices)
INVOICE_POLL_INTERVAL_SECONDS=60
MAX_PENDING_SWAPS=1000

# LNURL Settings
DOMAIN=127.0.0.1:8000
EXTERNAL_URL=http://127.0.0.1:8000
# Website (served by its own server; GET / redirects here).
# 8080 = servicio "web" del compose; 5173 = npm run dev.
FRONTEND_URL=http://127.0.0.1:8080
# URL de la API que el sitio lleva fija en el build (servicio "web").
PUBLIC_API_URL=http://127.0.0.1:8000

# Database Settings (solo uvicorn en el host; en docker es /data/ln2oc.db)
DATABASE_URL=sqlite:///./ln2oc.db

# App Settings
LOG_LEVEL=INFO
