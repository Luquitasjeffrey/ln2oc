# Muestra para PRODUCCIÓN: mainnet, LND del compose (neutrino). Copiar a .env en el
# checkout de prod y completar lo marcado con __COMPLETAR__ / revisar lo marcado REVISAR.
# Ver docs/prod.md.

COMPOSE_PROJECT_NAME=ln2oc-prod
# Suma el servicio "lnd" (deploy/lnd/mainnet.conf).
COMPOSE_PROFILES=lnd
# uid/gid del usuario que corre todo (dueño de los directorios de datos).
APP_UID=1000
APP_GID=1000

# --- LND (servicio "lnd" del compose) ---
# Datos de LND en el host (wallet, macaroons, tls, channel.backup). Lo crea
# scripts/lnd/init-dirs.sh. NO borrar nunca.
LND_DIR=/home/lucas/ln2oc/prod/data/lnd
LND_CONF=./deploy/lnd/mainnet.conf
# Rutas del HOST que docker compose monta en ln2oc. Existen recién cuando la wallet está
# creada (scripts/lnd/create-wallet.sh); antes de eso ln2oc no arranca, a propósito.
LND_MACAROON_PATH=/home/lucas/ln2oc/prod/data/lnd/data/chain/bitcoin/mainnet/admin.macaroon
LND_TLS_CERT_PATH=/home/lucas/ln2oc/prod/data/lnd/tls.cert
# ln2oc llega a LND por la red del compose ("lnd" está en el cert: tlsextradomain).
DOCKER_LND_GRPC_HOST=lnd:10009

# --- ln2oc ---
# Base de datos (preimages, raw tx): directorio del host, entra en el backup.
LN2OC_DATA=/home/lucas/ln2oc/prod/data/ln2oc

BITCOIN_NETWORK=mainnet
SWAP_FEE_RATE=0.007
MIN_PAYOUT_SAT=546
# REVISAR: piloto. Debajo de ~10k, con minería alta, muchos pagos terminan reembolsados.
MIN_SWAP_SAT=10000
# REVISAR: ajustar a la liquidez real: menor que la capacidad ENTRANTE de los canales y
# que el saldo on-chain menos ONCHAIN_RESERVE_SAT. Placeholder para un piloto de 500k.
MAX_SWAP_SAT=150000
MIN_SAT_PER_VBYTE=1
# Con neutrino la tasa viene de fee.url (externo): tope bajo para el piloto.
MAX_SAT_PER_VBYTE=100
ONCHAIN_RESERVE_SAT=10000

INVOICE_POLL_INTERVAL_SECONDS=60
MAX_PENDING_SWAPS=1000

# --- Dominio (el túnel de Cloudflare se arma aparte) ---
DOMAIN=ln2oc.com
EXTERNAL_URL=https://ln2oc.com
FRONTEND_URL=https://ln2oc.com
# URL de la API que el sitio lleva fija en el build: mismo dominio, ruteado por path.
PUBLIC_API_URL=https://ln2oc.com
CONTACT_TELEGRAM=LucasJeffreyP2P

# Puertos en el host: solo localhost (afuera se entra por el túnel). Distintos de los de
# dev para que las dos instancias convivan.
API_PUBLISH=127.0.0.1:8100
WEB_PUBLISH=127.0.0.1:8180

LOG_LEVEL=INFO
