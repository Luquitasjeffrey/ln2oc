# Testnet4 deployment (see docs/testnet4.md). Copy to .env and fill in the paths.
# LND Connection Settings
LND_GRPC_HOST=127.0.0.1:10009
LND_MACAROON_PATH=/ruta/lnd-servicio/data/chain/bitcoin/testnet4/admin.macaroon
LND_TLS_CERT_PATH=/ruta/lnd-servicio/tls.cert

# Bitcoin & Swap Settings
BITCOIN_NETWORK=testnet4
SWAP_FEE_RATE=0.007
MIN_PAYOUT_SAT=546
MIN_SWAP_SAT=1000
MAX_SWAP_SAT=1000000
MIN_SAT_PER_VBYTE=1
# The payout pays the fee rate when signing, capped at this multiple of the fee estimated before settling.
MINER_FEE_CAP_MULTIPLIER=2.0
# Held payments are paid together, one tx with one output each: at most this many per tx.
MAX_PAYOUT_BATCH=10

# Payment detection (synchronous polling of PENDING invoices)
INVOICE_POLL_INTERVAL_SECONDS=60
MAX_PENDING_SWAPS=5000

# LNURL Settings
DOMAIN=testnet.ln2oc.com
EXTERNAL_URL=https://testnet.ln2oc.com
# Website (served by its own server; GET / redirects here)
FRONTEND_URL=https://testnet.ln2oc.com/web/

# Database Settings
DATABASE_URL=sqlite:///./ln2oc.db

# App Settings
LOG_LEVEL=INFO
